<svg width="220" height="220" viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="appleGradient" x1="0" y1="0" x2="220" y2="220" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0071E3"/>
      <stop offset="50%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#818CF8"/>
    </linearGradient>
    <linearGradient id="glassGlare" x1="0" y1="0" x2="220" y2="110" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- iOS App Icon Squircle -->
  <rect width="220" height="220" rx="52" fill="url(#appleGradient)"/>
  
  <!-- Subtle Top Glare -->
  <rect width="220" height="110" rx="52" fill="url(#glassGlare)"/>

  <!-- Border Inner Stroke -->
  <rect x="1" y="1" width="218" height="218" rx="51" stroke="rgba(255,255,255,0.4)" stroke-width="2"/>

  <!-- JaxCliped Stylized J + Clip Scissors Emblem in Center -->
  <g filter="url(#glow)">
    <!-- Scissor Loop Left -->
    <circle cx="75" cy="78" r="22" stroke="#FFFFFF" stroke-width="12" fill="none"/>
    
    <!-- Scissor Loop Right/Bottom -->
    <circle cx="75" cy="142" r="22" stroke="#FFFFFF" stroke-width="12" fill="none"/>
    
    <!-- Cutting Blades / Play Arrow Crossing -->
    <path d="M92 90 L155 145" stroke="#FFFFFF" stroke-width="13" stroke-linecap="round"/>
    <path d="M92 130 L155 75" stroke="#FFFFFF" stroke-width="13" stroke-linecap="round"/>
    
    <!-- Modern Play Center Indicator -->
    <polygon points="120,95 152,110 120,125" fill="#FFFFFF"/>
  </g>
</svg>
